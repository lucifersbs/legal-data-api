{
  "metadata": {
    "title": "Legal Forms and Filing Information",
    "description": "Common legal form fees, filing locations, and e-filing availability by state",
    "lastUpdated": "2026-02-22",
    "disclaimer": "Fees and procedures change frequently. Verify with court clerk before filing."
  },
  "jurisdictions": {
    "CA": {
      "name": "California",
      "forms": {
        "civilComplaint": {
          "fee": 435,
          "where": "Superior Court Clerk",
          "efiling": true,
          "notes": "First paper filing fee varies by county"
        },
        "smallClaims": {
          "fee": "30-75 depending on claim amount",
          "where": "Small Claims Court Clerk",
          "efiling": true,
          "notes": "Claims up to $10,000 ($5,000 for businesses)"
        },
        "motion": {
          "fee": 60,
          "where": "Court where case pending",
          "efiling": true,
          "notes": "Fee varies by motion type"
        }
      },
      "efilingPortal": "https://efiling.courts.ca.gov",
      "courtClerkInfo": "Contact local Superior Court clerk"
    },
    "NY": {
      "name": "New York",
      "forms": {
        "civilComplaint": {
          "fee": 210,
          "where": "County Clerk or Supreme Court",
          "efiling": true,
          "notes": "Index number fee $210 plus other fees"
        },
        "smallClaims": {
          "fee": "15-20 depending on county",
          "where": "Small Claims Court",
          "efiling": false,
          "notes": "Claims up to $10,000 in NYC, $5,000 elsewhere"
        },
        "motion": {
          "fee": 45,
          "where": "Court where case pending",
          "efiling": true,
          "notes": "Motion fee varies by court"
        }
      },
      "efilingPortal": "https://iapps.courts.state.ny.us/nyscef/",
      "courtClerkInfo": "Contact local County Clerk"
    },
    "TX": {
      "name": "Texas",
      "forms": {
        "civilComplaint": {
          "fee": 54,
          "where": "District or County Clerk",
          "efiling": true,
          "notes": "Filing fee varies by county"
        },
        "smallClaims": {
          "fee": "54-116 depending on county",
          "where": "Justice of the Peace Court",
          "efiling": true,
          "notes": "Claims up to $20,000"
        },
        "motion": {
          "fee": 40,
          "where": "Court where case pending",
          "efiling": true,
          "notes": "Standard motion fee"
        }
      },
      "efilingPortal": "https://efile.txcourts.gov",
      "courtClerkInfo": "Contact local District or County Clerk"
    },
    "FL": {
      "name": "Florida",
      "forms": {
        "civilComplaint": {
          "fee": 401,
          "where": "Circuit Court Clerk",
          "efiling": true,
          "notes": "Filing fee plus service fees"
        },
        "smallClaims": {
          "fee": 55,
          "where": "County Court",
          "efiling": true,
          "notes": "Claims up to $8,000"
        },
        "motion": {
          "fee": 31,
          "where": "Court where case pending",
          "efiling": true,
          "notes": "Standard motion fee"
        }
      },
      "efilingPortal": "https://www.myfloridacounty.com/e-filing",
      "courtClerkInfo": "Contact local Circuit or County Court Clerk"
    },
    "IL": {
      "name": "Illinois",
      "forms": {
        "civilComplaint": {
          "fee": 337,
          "where": "Circuit Court Clerk",
          "efiling": true,
          "notes": "Filing fee varies by case type"
        },
        "smallClaims": {
          "fee": "89-264 depending on amount",
          "where": "Circuit Court - Small Claims Division",
          "efiling": true,
          "notes": "Claims up to $10,000"
        },
        "motion": {
          "fee": 50,
          "where": "Court where case pending",
          "efiling": true,
          "notes": "Motion fee varies"
        }
      },
